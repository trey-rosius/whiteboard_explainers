{
  "name": "aws-blocks-video",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "default",
  "blocksTemplateDescription": "Vite frontend with auth, DynamoDB, Bedrock, and realtime video orchestration",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch aws-blocks/scripts/server.ts",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "sandbox": "tsx --env-file=.env aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "tsx --env-file=.env aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "explainer": "tsx --env-file=.env explainer/cli/explainer.ts",
    "explainer:test": "tsx --tsconfig explainer/tsconfig.json explainer/test/themes.ts && tsx --tsconfig explainer/tsconfig.json explainer/test/recipes.ts && tsx --tsconfig explainer/tsconfig.json explainer/test/hardening.ts && tsx --tsconfig explainer/tsconfig.json explainer/test/title-and-notes.ts && tsx --tsconfig explainer/tsconfig.json explainer/test/story.ts && tsx --tsconfig explainer/tsconfig.json explainer/test/script-edit.ts && tsx --tsconfig explainer/tsconfig.json explainer/test/emphasis.ts && npm run -s explainer -- compile explainer/examples/database-sharding.json && tsx --tsconfig explainer/tsconfig.json explainer/test/smoke.tsx out/explainer/database-sharding/plan.json",
    "prebuild": "blocks-generate-client && npm run build:css",
    "build:css": "tailwindcss -i src/tailwind.css -o src/styles.css --minify"
  },
  "dependencies": {
    "@aws-blocks/blocks": "^0.8.0",
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-lambda": "^3.986.0",
    "@aws-sdk/client-polly": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@aws/durable-execution-sdk-js": "^3.0.0",
    "@dagrejs/dagre": "^3.1.3",
    "@iconify/react": "^6.0.4",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/lambda": "4.0.540",
    "@remotion/lambda-client": "4.0.540",
    "@remotion/layout-utils": "^4.0.540",
    "@remotion/transitions": "^4.0.540",
    "@types/dagre": "^0.7.54",
    "aws-icons": "^3.3.0",
    "lit-html": "^3.2.0",
    "lucide-static": "^1.66.0",
    "mpg123-decoder": "^1.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "roughjs": "^4.6.6",
    "simple-icons": "^16.36.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "19.3.0",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "blocksTemplateVersion": "0.1.0"
}
